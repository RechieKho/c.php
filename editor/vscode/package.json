{
  "name": "cphp",
  "displayName": "c.php",
  "description": "Syntax highlighting and problem matchers for C templates with embedded PHP (*.c.php)",
  "version": "0.1.0",
  "publisher": "rechiekho",
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cphp"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cphp",
        "aliases": [
          "C.PHP",
          "cphp"
        ],
        "filenamePatterns": [
          "*.c.php",
          "*.h.php"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cphp",
        "scopeName": "source.cphp",
        "path": "./syntaxes/cphp.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.php": "php",
          "source.c": "c"
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "cphp-gcc",
        "owner": "cphp",
        "source": "cphp",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(?:(\\d+):)?\\s+(warning|error|fatal error|note):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "cphp-msvc",
        "owner": "cphp",
        "source": "cphp",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s+(warning|error|fatal error)\\s+(\\w+\\d+)\\s*:\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      },
      {
        "name": "cphp-php",
        "owner": "cphp",
        "source": "cphp",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(?:PHP )?(Warning|Fatal error|Parse error|Notice|Deprecated|Error):\\s+(.*?) in (.+?) on line (\\d+)$",
          "severity": 1,
          "message": 2,
          "file": 3,
          "line": 4
        }
      }
    ],
    "commands": [
      {
        "command": "cphp.restart",
        "title": "c.php: Restart language server"
      }
    ],
    "configuration": {
      "title": "c.php",
      "properties": {
        "cphp.buildDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Directory with compile_commands.json. Empty: use cmake.buildDirectory, then search common build directories."
        },
        "cphp.clangdPath": {
          "type": "string",
          "default": "clangd",
          "scope": "machine-overridable",
          "description": "clangd executable."
        },
        "cphp.phpPath": {
          "type": "string",
          "default": "php",
          "scope": "machine-overridable",
          "description": "PHP CLI (>= 8.0) used to compute shadows."
        },
        "cphp.clangdArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Extra clangd arguments."
        },
        "cphp.phpServer": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "PHP language server executable (e.g. intelephense or phpactor language-server) for the PHP parts of templates. Empty: PHP regions get no language features."
        },
        "cphp.phpServerArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--stdio"
          ],
          "scope": "resource",
          "description": "Arguments for the PHP language server."
        }
      }
    },
    "breakpoints": [
      {
        "language": "cphp"
      }
    ],
    "configurationDefaults": {
      "[cphp]": {
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false
      }
    }
  },
  "scripts": {
    "test": "node test/run.js && node test/discovery-test.js",
    "stage": "node scripts/stage-server.js",
    "build": "esbuild extension.js --bundle --platform=node --format=cjs --external:vscode --minify --outfile=out/extension.js",
    "package": "node scripts/stage-server.js && npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/RichieKho/c.php"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "c.php runs clangd and php from the workspace configuration."
    },
    "virtualWorkspaces": false
  }
}
